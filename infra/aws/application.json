{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Crew hosted API, background worker and embedded web application",
  "Parameters": {
    "StartApplication": { "Type": "String", "Default": "false", "AllowedValues": ["false", "true"] },
    "FoundationStack": {
      "Type": "String",
      "AllowedPattern": "[A-Za-z][A-Za-z0-9-]{0,127}"
    },
    "VpcId": {
      "Type": "AWS::EC2::VPC::Id"
    },
    "Subnets": {
      "Type": "List<AWS::EC2::Subnet::Id>"
    },
    "Hostname": {
      "Type": "String",
      "AllowedPattern": "[a-z0-9][a-z0-9.-]+[a-z]"
    },
    "HostedZoneId": {
      "Type": "AWS::Route53::HostedZone::Id"
    },
    "AdminOrigin": {
      "Type": "String",
      "AllowedPattern": "https://[a-z0-9][a-z0-9.-]+[a-z]"
    },
    "ImageUri": {
      "Type": "String",
      "AllowedPattern": "[0-9]{12}\\.dkr\\.ecr\\.[a-z0-9-]+\\.amazonaws\\.com/[a-z0-9/_-]+@sha256:[a-f0-9]{64}"
    },
    "AdminExecutionRoleArn": {
      "Type": "String",
      "AllowedPattern": "arn:aws:iam::[0-9]{12}:role/[A-Za-z0-9+=,.@_/-]+"
    },
    "DesiredCount": {
      "Type": "Number",
      "Default": 1,
      "MinValue": 1,
      "MaxValue": 2
    }
  },
  "Conditions": { "Launch": { "Fn::Equals": [{ "Ref": "StartApplication" }, "true"] } },
  "Resources": {
    "ExecutionRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ecs-tasks.amazonaws.com"
              },
              "Action": "sts:AssumeRole",
              "Condition": {
                "StringEquals": {
                  "aws:SourceAccount": {
                    "Ref": "AWS::AccountId"
                  }
                },
                "ArnLike": {
                  "aws:SourceArn": {
                    "Fn::Sub": "arn:${AWS::Partition}:ecs:${AWS::Region}:${AWS::AccountId}:*"
                  }
                }
              }
            }
          ]
        },
        "ManagedPolicyArns": [
          {
            "Fn::Sub": "arn:${AWS::Partition}:iam::aws:policy/service-role/AmazonECSTaskExecutionRolePolicy"
          }
        ],
        "Policies": [
          {
            "PolicyName": "CrewSecrets",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "secretsmanager:GetSecretValue"
                  ],
                  "Resource": [
                    {
                      "Fn::ImportValue": {
                        "Fn::Sub": "${FoundationStack}:RuntimeDatabasePassword"
                      }
                    },
                    {
                      "Fn::ImportValue": {
                        "Fn::Sub": "${FoundationStack}:ContentEncryptionKey"
                      }
                    },
                    {
                      "Fn::ImportValue": {
                        "Fn::Sub": "${FoundationStack}:SessionSecret"
                      }
                    },
                    {
                      "Fn::ImportValue": {
                        "Fn::Sub": "${FoundationStack}:HostSessionSecret"
                      }
                    },
                    {
                      "Fn::ImportValue": {
                        "Fn::Sub": "${FoundationStack}:ScreenProxySecret"
                      }
                    },
                    {
                      "Fn::ImportValue": {
                        "Fn::Sub": "${FoundationStack}:DatabaseOwnerSecret"
                      }
                    }
                  ]
                }
              ]
            }
          }
        ]
      }
    },
    "TaskRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ecs-tasks.amazonaws.com"
              },
              "Action": "sts:AssumeRole",
              "Condition": {
                "StringEquals": {
                  "aws:SourceAccount": {
                    "Ref": "AWS::AccountId"
                  }
                },
                "ArnLike": {
                  "aws:SourceArn": {
                    "Fn::Sub": "arn:${AWS::Partition}:ecs:${AWS::Region}:${AWS::AccountId}:*"
                  }
                }
              }
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "CrewFiles",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "elasticfilesystem:ClientMount",
                    "elasticfilesystem:ClientWrite"
                  ],
                  "Resource": {
                    "Fn::Sub": [
                      "arn:${AWS::Partition}:elasticfilesystem:${AWS::Region}:${AWS::AccountId}:file-system/${Files}",
                      {
                        "Files": {
                          "Fn::ImportValue": {
                            "Fn::Sub": "${FoundationStack}:Files"
                          }
                        }
                      }
                    ]
                  },
                  "Condition": {
                    "StringEquals": {
                      "elasticfilesystem:AccessPointArn": [
                        {
                          "Fn::Sub": [
                            "arn:${AWS::Partition}:elasticfilesystem:${AWS::Region}:${AWS::AccountId}:access-point/${Point}",
                            {
                              "Point": {
                                "Fn::ImportValue": {
                                  "Fn::Sub": "${FoundationStack}:FilesAccessPoint"
                                }
                              }
                            }
                          ]
                        },
                        {
                          "Fn::Sub": [
                            "arn:${AWS::Partition}:elasticfilesystem:${AWS::Region}:${AWS::AccountId}:access-point/${Point}",
                            {
                              "Point": {
                                "Fn::ImportValue": {
                                  "Fn::Sub": "${FoundationStack}:WebAssetsAccessPoint"
                                }
                              }
                            }
                          ]
                        }
                      ]
                    }
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "AdminHostSecretAccess": {
      "Type": "AWS::SecretsManager::ResourcePolicy",
      "Properties": {
        "SecretId": {
          "Fn::ImportValue": {
            "Fn::Sub": "${FoundationStack}:HostSessionSecret"
          }
        },
        "BlockPublicPolicy": true,
        "ResourcePolicy": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "AWS": {
                  "Ref": "AdminExecutionRoleArn"
                }
              },
              "Action": "secretsmanager:GetSecretValue",
              "Resource": "*"
            }
          ]
        }
      }
    },
    "GatewaySecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "VpcId": {
          "Ref": "VpcId"
        },
        "GroupDescription": "Crew HTTPS gateway",
        "SecurityGroupIngress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 443,
            "ToPort": 443,
            "CidrIp": "0.0.0.0/0"
          }
        ]
      }
    },
    "RuntimeIngress": {
      "Type": "AWS::EC2::SecurityGroupIngress",
      "Properties": {
        "GroupId": {
          "Fn::ImportValue": {
            "Fn::Sub": "${FoundationStack}:RuntimeSecurityGroup"
          }
        },
        "IpProtocol": "tcp",
        "FromPort": 5173,
        "ToPort": 5173,
        "SourceSecurityGroupId": {
          "Ref": "GatewaySecurityGroup"
        }
      }
    },
    "Gateway": {
      "Type": "AWS::ElasticLoadBalancingV2::LoadBalancer",
      "Properties": {
        "Scheme": "internet-facing",
        "Type": "application",
        "Subnets": {
          "Ref": "Subnets"
        },
        "SecurityGroups": [
          {
            "Ref": "GatewaySecurityGroup"
          }
        ]
      }
    },
    "Certificate": {
      "Type": "AWS::CertificateManager::Certificate",
      "Properties": {
        "DomainName": {
          "Ref": "Hostname"
        },
        "ValidationMethod": "DNS",
        "DomainValidationOptions": [
          {
            "DomainName": {
              "Ref": "Hostname"
            },
            "HostedZoneId": {
              "Ref": "HostedZoneId"
            }
          }
        ]
      }
    },
    "Target": {
      "Type": "AWS::ElasticLoadBalancingV2::TargetGroup",
      "Properties": {
        "VpcId": {
          "Ref": "VpcId"
        },
        "Protocol": "HTTP",
        "Port": 5173,
        "TargetType": "ip",
        "HealthCheckPath": "/",
        "HealthCheckIntervalSeconds": 30,
        "TargetGroupAttributes": [
          {
            "Key": "deregistration_delay.timeout_seconds",
            "Value": "60"
          }
        ]
      }
    },
    "Listener": {
      "Type": "AWS::ElasticLoadBalancingV2::Listener",
      "Properties": {
        "LoadBalancerArn": {
          "Ref": "Gateway"
        },
        "Port": 443,
        "Protocol": "HTTPS",
        "SslPolicy": "ELBSecurityPolicy-TLS13-1-2-2021-06",
        "Certificates": [
          {
            "CertificateArn": {
              "Ref": "Certificate"
            }
          }
        ],
        "DefaultActions": [
          {
            "Type": "forward",
            "TargetGroupArn": {
              "Ref": "Target"
            }
          }
        ]
      }
    },
    "Dns": {
      "Type": "AWS::Route53::RecordSet",
      "Properties": {
        "HostedZoneId": {
          "Ref": "HostedZoneId"
        },
        "Name": {
          "Ref": "Hostname"
        },
        "Type": "A",
        "AliasTarget": {
          "DNSName": {
            "Fn::GetAtt": [
              "Gateway",
              "DNSName"
            ]
          },
          "HostedZoneId": {
            "Fn::GetAtt": [
              "Gateway",
              "CanonicalHostedZoneID"
            ]
          },
          "EvaluateTargetHealth": true
        }
      }
    },
    "Runtime": {
      "Type": "AWS::ECS::TaskDefinition",
      "Properties": {
        "Family": {
          "Fn::Sub": "${AWS::StackName}-runtime"
        },
        "RequiresCompatibilities": [
          "FARGATE"
        ],
        "NetworkMode": "awsvpc",
        "Cpu": "1024",
        "Memory": "2048",
        "EphemeralStorage": {
          "SizeInGiB": 30
        },
        "ExecutionRoleArn": {
          "Fn::GetAtt": [
            "ExecutionRole",
            "Arn"
          ]
        },
        "TaskRoleArn": {
          "Fn::GetAtt": [
            "TaskRole",
            "Arn"
          ]
        },
        "Volumes": [
          {
            "Name": "data",
            "EFSVolumeConfiguration": {
              "FilesystemId": {
                "Fn::ImportValue": {
                  "Fn::Sub": "${FoundationStack}:Files"
                }
              },
              "TransitEncryption": "ENABLED",
              "AuthorizationConfig": {
                "AccessPointId": {
                  "Fn::ImportValue": {
                    "Fn::Sub": "${FoundationStack}:FilesAccessPoint"
                  }
                },
                "IAM": "ENABLED"
              }
            }
          },
          {
            "Name": "webassets",
            "EFSVolumeConfiguration": {
              "FilesystemId": {
                "Fn::ImportValue": {
                  "Fn::Sub": "${FoundationStack}:Files"
                }
              },
              "TransitEncryption": "ENABLED",
              "AuthorizationConfig": {
                "AccessPointId": {
                  "Fn::ImportValue": {
                    "Fn::Sub": "${FoundationStack}:WebAssetsAccessPoint"
                  }
                },
                "IAM": "ENABLED"
              }
            }
          }
        ],
        "ContainerDefinitions": [
          {
            "Name": "api",
            "Image": {
              "Ref": "ImageUri"
            },
            "Essential": true,
            "User": "1000",
            "Command": [
              "node",
              "/app/infra/aws/start.mjs",
              "api"
            ],
            "StopTimeout": 120,
            "LogConfiguration": {
              "LogDriver": "awslogs",
              "Options": {
                "awslogs-group": {
                  "Fn::ImportValue": {
                    "Fn::Sub": "${FoundationStack}:Logs"
                  }
                },
                "awslogs-region": {
                  "Ref": "AWS::Region"
                },
                "awslogs-stream-prefix": "api",
                "mode": "blocking"
              }
            },
            "Environment": [
              {
                "Name": "NODE_ENV",
                "Value": "production"
              },
              {
                "Name": "DATABASE_HOST",
                "Value": {
                  "Fn::ImportValue": {
                    "Fn::Sub": "${FoundationStack}:DatabaseHost"
                  }
                }
              },
              {
                "Name": "DATA_DIR",
                "Value": "/data"
              },
              {
                "Name": "SECRET_STORE",
                "Value": "encrypted"
              },
              {
                "Name": "CONTENT_ENCRYPTION",
                "Value": "on"
              },
              {
                "Name": "WAKEUP_DRIVER",
                "Value": "graphile"
              },
              {
                "Name": "AGENT_RUNTIME",
                "Value": "pi"
              },
              {
                "Name": "SANDBOX_PROVIDER",
                "Value": "none"
              },
              {
                "Name": "BROWSER_PROVIDER",
                "Value": "none"
              },
              {
                "Name": "API_URL",
                "Value": {
                  "Fn::Sub": "https://${Hostname}"
                }
              },
              {
                "Name": "MAX_TOOL_CALLS_PER_TURN",
                "Value": "80"
              },
              {
                "Name": "LOG_FORMAT",
                "Value": "json"
              },
              {
                "Name": "API_HOST",
                "Value": "0.0.0.0"
              },
              {
                "Name": "API_PORT",
                "Value": "3100"
              },
              {
                "Name": "BETTER_AUTH_URL",
                "Value": {
                  "Fn::Sub": "https://${Hostname}"
                }
              },
              {
                "Name": "WEB_ORIGIN",
                "Value": {
                  "Fn::Sub": "https://${Hostname}"
                }
              },
              {
                "Name": "HOST_SESSION_ORIGIN",
                "Value": {
                  "Ref": "AdminOrigin"
                }
              },
              {
                "Name": "AUTH_PASSWORD_ENABLED",
                "Value": "false"
              },
              {
                "Name": "SIGNUPS_ENABLED",
                "Value": "false"
              }
            ],
            "Secrets": [
              {
                "Name": "DATABASE_PASSWORD",
                "ValueFrom": {
                  "Fn::ImportValue": {
                    "Fn::Sub": "${FoundationStack}:RuntimeDatabasePassword"
                  }
                }
              },
              {
                "Name": "ENCRYPTION_KEY",
                "ValueFrom": {
                  "Fn::ImportValue": {
                    "Fn::Sub": "${FoundationStack}:ContentEncryptionKey"
                  }
                }
              },
              {
                "Name": "BETTER_AUTH_SECRET",
                "ValueFrom": {
                  "Fn::ImportValue": {
                    "Fn::Sub": "${FoundationStack}:SessionSecret"
                  }
                }
              },
              {
                "Name": "HOST_SESSION_SECRET",
                "ValueFrom": {
                  "Fn::ImportValue": {
                    "Fn::Sub": "${FoundationStack}:HostSessionSecret"
                  }
                }
              },
              {
                "Name": "SCREEN_PROXY_SECRET",
                "ValueFrom": {
                  "Fn::ImportValue": {
                    "Fn::Sub": "${FoundationStack}:ScreenProxySecret"
                  }
                }
              }
            ],
            "PortMappings": [
              {
                "ContainerPort": 3100
              }
            ],
            "MountPoints": [
              {
                "SourceVolume": "data",
                "ContainerPath": "/data"
              }
            ],
            "HealthCheck": {
              "Command": [
                "CMD-SHELL",
                "node -e \"fetch('http://127.0.0.1:3100/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))\""
              ],
              "Interval": 30,
              "Timeout": 5,
              "Retries": 3,
              "StartPeriod": 120
            }
          },
          {
            "Name": "worker",
            "Image": {
              "Ref": "ImageUri"
            },
            "Essential": true,
            "User": "1000",
            "Command": [
              "node",
              "/app/infra/aws/start.mjs",
              "worker"
            ],
            "StopTimeout": 120,
            "LogConfiguration": {
              "LogDriver": "awslogs",
              "Options": {
                "awslogs-group": {
                  "Fn::ImportValue": {
                    "Fn::Sub": "${FoundationStack}:Logs"
                  }
                },
                "awslogs-region": {
                  "Ref": "AWS::Region"
                },
                "awslogs-stream-prefix": "worker",
                "mode": "blocking"
              }
            },
            "Environment": [
              {
                "Name": "NODE_ENV",
                "Value": "production"
              },
              {
                "Name": "DATABASE_HOST",
                "Value": {
                  "Fn::ImportValue": {
                    "Fn::Sub": "${FoundationStack}:DatabaseHost"
                  }
                }
              },
              {
                "Name": "DATA_DIR",
                "Value": "/data"
              },
              {
                "Name": "SECRET_STORE",
                "Value": "encrypted"
              },
              {
                "Name": "CONTENT_ENCRYPTION",
                "Value": "on"
              },
              {
                "Name": "WAKEUP_DRIVER",
                "Value": "graphile"
              },
              {
                "Name": "AGENT_RUNTIME",
                "Value": "pi"
              },
              {
                "Name": "SANDBOX_PROVIDER",
                "Value": "none"
              },
              {
                "Name": "BROWSER_PROVIDER",
                "Value": "none"
              },
              {
                "Name": "API_URL",
                "Value": {
                  "Fn::Sub": "https://${Hostname}"
                }
              },
              {
                "Name": "MAX_TOOL_CALLS_PER_TURN",
                "Value": "80"
              },
              {
                "Name": "LOG_FORMAT",
                "Value": "json"
              }
            ],
            "Secrets": [
              {
                "Name": "DATABASE_PASSWORD",
                "ValueFrom": {
                  "Fn::ImportValue": {
                    "Fn::Sub": "${FoundationStack}:RuntimeDatabasePassword"
                  }
                }
              },
              {
                "Name": "ENCRYPTION_KEY",
                "ValueFrom": {
                  "Fn::ImportValue": {
                    "Fn::Sub": "${FoundationStack}:ContentEncryptionKey"
                  }
                }
              }
            ],
            "MountPoints": [
              {
                "SourceVolume": "data",
                "ContainerPath": "/data"
              }
            ],
            "DependsOn": [
              {
                "ContainerName": "api",
                "Condition": "HEALTHY"
              }
            ],
            "HealthCheck": {
              "Command": [
                "CMD-SHELL",
                "node /app/apps/worker/dist/health-check.js"
              ],
              "Interval": 30,
              "Timeout": 5,
              "Retries": 3,
              "StartPeriod": 120
            }
          },
          {
            "Name": "web",
            "Image": {
              "Ref": "ImageUri"
            },
            "Essential": true,
            "User": "1000",
            "Command": [
              "node",
              "/app/infra/aws/start.mjs",
              "web"
            ],
            "StopTimeout": 120,
            "LogConfiguration": {
              "LogDriver": "awslogs",
              "Options": {
                "awslogs-group": {
                  "Fn::ImportValue": {
                    "Fn::Sub": "${FoundationStack}:Logs"
                  }
                },
                "awslogs-region": {
                  "Ref": "AWS::Region"
                },
                "awslogs-stream-prefix": "web",
                "mode": "blocking"
              }
            },
            "Environment": [
              {
                "Name": "API_PROXY_TARGET",
                "Value": "http://127.0.0.1:3100"
              },
              {
                "Name": "RAKAZO_HOST",
                "Value": {
                  "Ref": "Hostname"
                }
              },
              {
                "Name": "RAKAZO_EMBED_ORIGINS",
                "Value": {
                  "Ref": "AdminOrigin"
                }
              }
            ],
            "Secrets": [
              {
                "Name": "SCREEN_PROXY_SECRET",
                "ValueFrom": {
                  "Fn::ImportValue": {
                    "Fn::Sub": "${FoundationStack}:ScreenProxySecret"
                  }
                }
              }
            ],
            "PortMappings": [
              {
                "ContainerPort": 5173
              }
            ],
            "MountPoints": [
              {
                "SourceVolume": "webassets",
                "ContainerPath": "/app/apps/web/asset-archive"
              }
            ],
            "DependsOn": [
              {
                "ContainerName": "api",
                "Condition": "HEALTHY"
              }
            ],
            "HealthCheck": {
              "Command": [
                "CMD-SHELL",
                "node -e \"fetch('http://127.0.0.1:5173/').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))\""
              ],
              "Interval": 30,
              "Timeout": 5,
              "Retries": 3,
              "StartPeriod": 120
            }
          }
        ]
      }
    },
    "Migration": {
      "Type": "AWS::ECS::TaskDefinition",
      "Properties": {
        "Family": {
          "Fn::Sub": "${AWS::StackName}-migration"
        },
        "RequiresCompatibilities": [
          "FARGATE"
        ],
        "NetworkMode": "awsvpc",
        "Cpu": "1024",
        "Memory": "2048",
        "ExecutionRoleArn": {
          "Fn::GetAtt": [
            "ExecutionRole",
            "Arn"
          ]
        },
        "ContainerDefinitions": [
          {
            "Name": "migrate",
            "Image": {
              "Ref": "ImageUri"
            },
            "Essential": true,
            "User": "1000",
            "Command": [
              "node",
              "/app/infra/aws/start.mjs",
              "migrate"
            ],
            "StopTimeout": 120,
            "LogConfiguration": {
              "LogDriver": "awslogs",
              "Options": {
                "awslogs-group": {
                  "Fn::ImportValue": {
                    "Fn::Sub": "${FoundationStack}:Logs"
                  }
                },
                "awslogs-region": {
                  "Ref": "AWS::Region"
                },
                "awslogs-stream-prefix": "migrate",
                "mode": "blocking"
              }
            },
            "Environment": [
              {
                "Name": "NODE_ENV",
                "Value": "production"
              },
              {
                "Name": "DATABASE_HOST",
                "Value": {
                  "Fn::ImportValue": {
                    "Fn::Sub": "${FoundationStack}:DatabaseHost"
                  }
                }
              }
            ],
            "Secrets": [
              {
                "Name": "DATABASE_PASSWORD",
                "ValueFrom": {
                  "Fn::ImportValue": {
                    "Fn::Sub": "${FoundationStack}:RuntimeDatabasePassword"
                  }
                }
              },
              {
                "Name": "DATABASE_OWNER_PASSWORD",
                "ValueFrom": {
                  "Fn::Sub": [
                    "${OwnerSecret}:password::",
                    {
                      "OwnerSecret": {
                        "Fn::ImportValue": {
                          "Fn::Sub": "${FoundationStack}:DatabaseOwnerSecret"
                        }
                      }
                    }
                  ]
                }
              }
            ]
          }
        ]
      }
    },
    "Service": {
      "Condition": "Launch",
      "Type": "AWS::ECS::Service",
      "DependsOn": [
        "Listener",
        "RuntimeIngress"
      ],
      "Properties": {
        "Cluster": {
          "Fn::ImportValue": {
            "Fn::Sub": "${FoundationStack}:Cluster"
          }
        },
        "TaskDefinition": {
          "Ref": "Runtime"
        },
        "LaunchType": "FARGATE",
        "PlatformVersion": "LATEST",
        "DesiredCount": {
          "Ref": "DesiredCount"
        },
        "HealthCheckGracePeriodSeconds": 180,
        "DeploymentConfiguration": {
          "MinimumHealthyPercent": 100,
          "MaximumPercent": 200,
          "DeploymentCircuitBreaker": {
            "Enable": true,
            "Rollback": true
          }
        },
        "NetworkConfiguration": {
          "AwsvpcConfiguration": {
            "AssignPublicIp": "ENABLED",
            "Subnets": {
              "Ref": "Subnets"
            },
            "SecurityGroups": [
              {
                "Fn::ImportValue": {
                  "Fn::Sub": "${FoundationStack}:RuntimeSecurityGroup"
                }
              }
            ]
          }
        },
        "LoadBalancers": [
          {
            "ContainerName": "web",
            "ContainerPort": 5173,
            "TargetGroupArn": {
              "Ref": "Target"
            }
          }
        ],
        "EnableECSManagedTags": true,
        "PropagateTags": "SERVICE"
      }
    }
  },
  "Outputs": {
    "Origin": {
      "Value": {
        "Fn::Sub": "https://${Hostname}"
      }
    },
    "Service": {
      "Condition": "Launch",
      "Value": {
        "Ref": "Service"
      }
    },
